{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Servir sitio local",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/serve.ps1"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "local-site",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Starting local site",
                    "endsPattern": "^Local site ready at http://127\\.0\\.0\\.1:8080/$"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}