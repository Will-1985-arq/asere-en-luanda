{
  "name": "sere-luanda-separado",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:compression": "esbuild scripts/image-compression-entry.js --bundle --format=iife --platform=browser --outfile=image-compression.js",
    "build:css": "tailwindcss --config ./tailwind.config.js --input ./tailwind.input.css --output ./tailwind.generated.css --minify",
    "prebuild:wix": "npm run build:compression && npm run build:css",
    "build:wix": "node ./scripts/build-wix.mjs"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.18"
  }
}